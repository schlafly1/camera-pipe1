# Copy this file to .env and fill in your camera RTSP URLs.
# .env is gitignored and never committed.

RTSP_URL_CAM1=rtsp://user:password@192.168.x.x:554/stream
RTSP_URL_CAM2=rtsp://user:password@192.168.x.x:554/stream
RTSP_URL_CAM3=rtsp://user:password@192.168.x.x:554/stream
RTSP_URL_CAM4=rtsp://user:password@192.168.x.x:554/stream

# Set to 4 to force TCP transport for cameras that block UDP RTP.
# Leave unset or 0 for default UDP. Dahua cameras often require TCP.
# RTSP_TRANSPORT_CAM1=4
# RTSP_TRANSPORT_CAM2=4
# RTSP_TRANSPORT_CAM3=4
# RTSP_TRANSPORT_CAM4=4

# VLM model used for scene descriptions (default: gemma4:26b).
# Override to switch all cameras at once. Must be pulled with `ollama pull`.
# VLM_MODEL=nemotron3:33b
VLM_MODEL=gemma4:26b

# Ollama host — change to a remote Jetson IP to offload VLM inference off this device.
# The remote Jetson must be running `OLLAMA_HOST=0.0.0.0 ollama serve`
# and have the models pulled: ollama pull gemma4:26b && ollama pull nomic-embed-text
# OLLAMA_HOST=http://192.168.x.x:11434
OLLAMA_HOST=http://localhost:11434

# X11 display — :1 is the Jetson's local display when accessed over SSH.
# Run `xhost +local:` on the host before starting containers.
# Only needed for legacy cam1.yml or HEADLESS=0 with cam_multi.yml.
DISPLAY=:1

# ── Multi-stream pipeline (cam_multi.yml / pipeline_multi.py) ────────────────

# Mux output size — use substream resolution when possible (e.g. 1280x720).
FRAME_W=1280
FRAME_H=720

# Live 2x2 video tile with bounding boxes (requires X11; see SPARK_DEV.md)
ENABLE_DISPLAY=0

# Legacy alias: HEADLESS=0 also enables display (same as ENABLE_DISPLAY=1)
HEADLESS=1

# Tile window size when ENABLE_DISPLAY=1
TILER_W=1280
TILER_H=720

# Host path to .Xauthority for docker compose (Linux desktop / SSH -X)
# XAUTHORITY_HOST=/home/you/.Xauthority

# Shared VLM queue depth across all cameras in pipeline_multi.py
VLM_QUEUE_MAX=12

# Min seconds between ChromaDB saves per object class per camera.
# Increase this (e.g. 30 or 60) if VLM/Ollama can't keep up with detections
# (you'll see high queue_depth and drops in monitor.py).
SAVE_INTERVAL=30.0

# Camera type for differential handling:
#   "office" = test/high-volume cams (throttled by SAVE_INTERVAL; dropped if VLM busy)
#   "street" = real low-volume cams (VLM on every detection; never throttled)
# Office cams can be sacrificed to protect street cams.
# Defaults to "street".
# CAM_TYPE_CAM1=office
# CAM_TYPE_CAM2=office
# CAM_TYPE_CAM3=street
# CAM_TYPE_CAM4=street
# CAM_TYPE_CAM5=street
# CAM_TYPE_CAM6=street

